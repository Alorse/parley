{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first English speaking tutor — PWA on top of the Gemini Live API",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node --import tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "test": "node --import tsx --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.worklet.json",
    "e2e": "node scripts/e2e-live.mjs",
    "browser-check": "node scripts/browser-check.mjs",
    "icons": "python3 scripts/make_icons.py"
  },
  "dependencies": {
    "tsx": "^4.23.13",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^20.19.43",
    "@types/serviceworker": "^0.0.201",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
