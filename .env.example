# ---- Parley configuration -------------------------------------------------

# Google AI (Gemini) API key. Never commit the real value.
GOOGLE_API_KEY=

# Live (speech-to-speech) model used for the conversation.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Comma-separated live models to try in order if the primary one fails to
# complete setup (outage/quota). Tried in order, first one that connects wins.
GEMINI_LIVE_MODEL_FALLBACKS=gemini-3.1-flash-live-preview

# Text model used for the post-turn review (score / corrections / words)
# and for the "Meaning" translator.
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Comma-separated text models to try in order on a 429 (quota exhausted) or
# 503 (overloaded) from the primary model.
GEMINI_TEXT_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-3.5-flash

# Prebuilt voice for the tutor: Puck | Charon | Kore | Fenrir | Aoede | Leda
TUTOR_VOICE=Kore

# HTTP port (127.0.0.1 behind the tunnel)
PORT=8322

# Optional: comma-separated bearer tokens required to open a live session.
# Leave empty for an open (but obscure-URL) release.
ACCESS_TOKENS=

# Where the .data store lives (relative to the project root)
DATA_DIR=.data
